<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Crest</RootNamespace>
    <AssemblyName>Crest</AssemblyName>
    <Product>Crest</Product>
    <!-- WPF0001: ThemeMode (Fluent) is marked experimental; a C# pragma does not cover XAML.
         WFO0003: a WinForms-only analyzer; this is a WPF app, so DPI awareness belongs in app.manifest. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep Application, Color, MessageBox etc. as WPF types; WinForms types are named in full. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Crest.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Garbage-heap cap (decision D-20261124-crest-gen0-cap). .NET sizes the young-object heap from the CPU cache
         (16 MB on a 32 MB-cache Ryzen), which was two thirds of Crest's memory. 4 MB means more, but tiny, collections. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="4194304" />
  </ItemGroup>

</Project>

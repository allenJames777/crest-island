<Window x:Class="Crest.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crest settings"
        Width="560" Height="720" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel LastChildFill="False">
                <Button x:Name="ResetButton" Content="Reset to defaults" Click="OnReset" DockPanel.Dock="Left" />
                <Button Content="Done" Click="OnDone" DockPanel.Dock="Right" MinWidth="90" IsDefault="True" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,4,20,20">

                <!-- Look -->
                <TextBlock Style="{StaticResource Section}" Text="Look" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Theme" />
                    <ComboBox x:Name="ThemeBox" AutomationProperties.Name="Theme" Grid.Column="1" SelectionChanged="OnChanged">
                        <ComboBoxItem Content="Midnight" Tag="Midnight" />
                        <ComboBoxItem Content="Album tint" Tag="AlbumTint" />
                        <ComboBoxItem Content="Graphite" Tag="Graphite" />
                        <ComboBoxItem Content="Frost" Tag="Frost" />
                        <ComboBoxItem Content="Custom colours" Tag="Custom" />
                    </ComboBox>
                </Grid>
                <StackPanel x:Name="CustomColours">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Background colour" />
                        <TextBox x:Name="BackgroundBox" AutomationProperties.Name="Background colour" Grid.Column="1" LostFocus="OnColourCommitted" KeyDown="OnColourKey" />
                        <Border x:Name="BackgroundSwatch" Grid.Column="2" Width="28" Height="28" CornerRadius="6" Margin="10,0,0,0"
                                BorderThickness="1" BorderBrush="#40808080" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Text colour" />
                        <TextBox x:Name="TextColourBox" AutomationProperties.Name="Text colour" Grid.Column="1" LostFocus="OnColourCommitted" KeyDown="OnColourKey" />
                        <Border x:Name="TextSwatch" Grid.Column="2" Width="28" Height="28" CornerRadius="6" Margin="10,0,0,0"
                                BorderThickness="1" BorderBrush="#40808080" />
                    </Grid>
                </StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Transparency" />
                    <Slider x:Name="TransparencySlider" AutomationProperties.Name="Transparency" Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                    <TextBlock x:Name="TransparencyValue" Grid.Column="2" Style="{StaticResource Value}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Accent colour" />
                    <ComboBox x:Name="AccentBox" AutomationProperties.Name="Accent colour" Grid.Column="1" SelectionChanged="OnChanged">
                        <ComboBoxItem Content="From the album art" Tag="FromAlbumArt" />
                        <ComboBoxItem Content="Fixed colour" Tag="Fixed" />
                    </ComboBox>
                </Grid>
                <Grid x:Name="FixedAccentRow" Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Fixed accent" />
                    <TextBox x:Name="AccentColourBox" AutomationProperties.Name="Fixed accent" Grid.Column="1" LostFocus="OnColourCommitted" KeyDown="OnColourKey" />
                    <Border x:Name="AccentSwatch" Grid.Column="2" Width="28" Height="28" CornerRadius="6" Margin="10,0,0,0"
                            BorderThickness="1" BorderBrush="#40808080" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Shape" />
                    <ComboBox x:Name="ShapeBox" AutomationProperties.Name="Shape" Grid.Column="1" SelectionChanged="OnChanged">
                        <ComboBoxItem Content="Notch (hangs from the top edge)" Tag="Notch" />
                        <ComboBoxItem Content="Floating" Tag="Floating" />
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Roundness" />
                    <Slider x:Name="RoundnessSlider" AutomationProperties.Name="Roundness" Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                    <TextBlock x:Name="RoundnessValue" Grid.Column="2" Style="{StaticResource Value}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Size" />
                    <Slider x:Name="ScaleSlider" AutomationProperties.Name="Size" Grid.Column="1" Minimum="85" Maximum="120" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                    <TextBlock x:Name="ScaleValue" Grid.Column="2" Style="{StaticResource Value}" />
                </Grid>
                <CheckBox x:Name="AlbumArtCheck" Content="Show album art" Margin="0,6" Checked="OnChanged" Unchecked="OnChanged" />
                <CheckBox x:Name="EqualizerCheck" Content="Show the bouncing bars while music plays" Margin="0,6" Checked="OnChanged" Unchecked="OnChanged" />

                <!-- Behaviour -->
                <TextBlock Style="{StaticResource Section}" Text="Behaviour" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Open the island" />
                    <ComboBox x:Name="ExpandOnBox" AutomationProperties.Name="Open the island" Grid.Column="1" SelectionChanged="OnChanged">
                        <ComboBoxItem Content="When I hover over it" Tag="Hover" />
                        <ComboBoxItem Content="When I click it" Tag="Click" />
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Hover delay" />
                    <Slider x:Name="HoverDelaySlider" AutomationProperties.Name="Hover delay" Grid.Column="1" Minimum="0" Maximum="1500" TickFrequency="50"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                    <TextBlock x:Name="HoverDelayValue" Grid.Column="2" Style="{StaticResource Value}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Close after leaving" />
                    <Slider x:Name="CollapseDelaySlider" AutomationProperties.Name="Close after leaving" Grid.Column="1" Minimum="0" Maximum="3000" TickFrequency="100"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                    <TextBlock x:Name="CollapseDelayValue" Grid.Column="2" Style="{StaticResource Value}" />
                </Grid>
                <CheckBox x:Name="AutoTuckCheck" Content="Tuck into a thin line while music plays" Margin="0,6" Checked="OnChanged" Unchecked="OnChanged" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="When nothing is playing" />
                    <ComboBox x:Name="NothingPlayingBox" AutomationProperties.Name="When nothing is playing" Grid.Column="1" SelectionChanged="OnChanged">
                        <ComboBoxItem Content="Tuck into a thin line" Tag="Tuck" />
                        <ComboBoxItem Content="Keep the pill" Tag="KeepPill" />
                        <ComboBoxItem Content="Hide" Tag="Hide" />
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="While a timer runs" />
                    <ComboBox x:Name="WhileTimerRunsBox" AutomationProperties.Name="While a timer runs" Grid.Column="1" SelectionChanged="OnChanged">
                        <ComboBoxItem Content="Show the timer pill" Tag="TimerPill" />
                        <ComboBoxItem Content="Stay tucked" Tag="StayTucked" />
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="PeekCheck" Content="Show the new song for a moment when it changes" Margin="0,6" Checked="OnChanged" Unchecked="OnChanged" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Show it for" />
                    <Slider x:Name="PeekSlider" AutomationProperties.Name="Show the new song for" Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                    <TextBlock x:Name="PeekValue" Grid.Column="2" Style="{StaticResource Value}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Over full-screen apps" />
                    <ComboBox x:Name="FullScreenBox" AutomationProperties.Name="Over full-screen apps" Grid.Column="1" SelectionChanged="OnChanged">
                        <ComboBoxItem Content="Tuck into a thin line" Tag="Tuck" />
                        <ComboBoxItem Content="Hide" Tag="Hide" />
                        <ComboBoxItem Content="Keep showing" Tag="Show" />
                    </ComboBox>
                </Grid>

                <!-- Display -->
                <TextBlock Style="{StaticResource Section}" Text="Display" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Show the island on" />
                    <ComboBox x:Name="DisplayBox" AutomationProperties.Name="Show the island on" Grid.Column="1" SelectionChanged="OnChanged" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Position along the top" />
                    <Slider x:Name="PositionSlider" AutomationProperties.Name="Position along the top" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                    <TextBlock x:Name="PositionValue" Grid.Column="2" Style="{StaticResource Value}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Gap from the top" />
                    <Slider x:Name="TopOffsetSlider" AutomationProperties.Name="Gap from the top" Grid.Column="1" Minimum="0" Maximum="40" TickFrequency="2"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                    <TextBlock x:Name="TopOffsetValue" Grid.Column="2" Style="{StaticResource Value}" />
                </Grid>

                <!-- System -->
                <TextBlock Style="{StaticResource Section}" Text="System" />
                <CheckBox x:Name="StartupCheck" Content="Start Crest with Windows" Margin="0,6" Checked="OnChanged" Unchecked="OnChanged" />
                <CheckBox x:Name="VisibleCheck" Content="Show the island" Margin="0,6" Checked="OnChanged" Unchecked="OnChanged" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Animations" />
                    <ComboBox x:Name="AnimationsBox" AutomationProperties.Name="Animations" Grid.Column="1" SelectionChanged="OnChanged">
                        <ComboBoxItem Content="Follow Windows" Tag="FollowWindows" />
                        <ComboBoxItem Content="On" Tag="On" />
                        <ComboBoxItem Content="Off" Tag="Off" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="Crest.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crest"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Left="-20000" Top="-20000" Width="10" Height="10">
    <!-- Island colours (IslandBg, IslandFg, IslandMuted, IslandLine, IslandTrack, IslandHover, IslandButton,
         IslandButtonFg, IslandAccent) are added to Resources in code from ThemePalette. -->
    <Window.Resources>
        <Style x:Key="Layer" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource IslandMuted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Time" TargetType="TextBlock" BasedOn="{StaticResource Sub}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- Round icon buttons (design page .cb). -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="999" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource IslandHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{DynamicResource IslandButton}" />
            <Setter Property="Foreground" Value="{DynamicResource IslandButtonFg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="999" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.07" ScaleY="1.07" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="6,2,8,2" />
            <Setter Property="Background" Value="{DynamicResource IslandHover}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="9" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource IslandTrack}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The Timers page's 66 DIP tile, where the album art sits on the music page (design page .ttile). -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="15" Background="{TemplateBinding Background}" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small square icon buttons for reset, delete and the confirm ✓ / ✕ (design page .ia). -->
        <Style x:Key="SmallIconButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource IslandMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource IslandHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource IslandFg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A list row's round play button (design page .tb). -->
        <Style x:Key="RowPlayButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource IslandHover}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The New timer row (design page .tnew): a whole-row button with a light hover. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="10" Padding="4,0,6,0" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource IslandHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallIcon" TargetType="Path">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Geometry x:Key="ResetGeometry">M4.5,12 A7.5,7.5 0 1 0 6.7,6.7 M4.5,4.5 V8.7 H8.7</Geometry>
        <Geometry x:Key="CrossGeometry">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</Geometry>
        <Geometry x:Key="CheckGeometry">M5,12.5 L9.5,17 L19,7.5</Geometry>
        <Geometry x:Key="NoteGeometry">M9,17.5 V6.2 L19,4 V15.5</Geometry>
        <Style x:Key="FilledIcon" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="StrokedIcon" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <!-- Icon shapes from the design page (24 x 24 grid). -->
        <Geometry x:Key="StopwatchGeometry">M19.2,13.5 A7.2,7.2 0 1 1 4.8,13.5 A7.2,7.2 0 1 1 19.2,13.5 Z M12,13.5 V10 M9.6,3 H14.4 M18.2,6.8 L19.5,5.5</Geometry>
        <Geometry x:Key="NextGeometry">M5,6.2 V17.8 A0.9,0.9 0 0 0 6.4,18.55 L15,12.75 A0.9,0.9 0 0 0 15,11.25 L6.4,5.45 A0.9,0.9 0 0 0 5,6.2 Z M17.6,5.5 H18.9 A1.2,1.2 0 0 1 20.1,6.7 V17.3 A1.2,1.2 0 0 1 18.9,18.5 H17.6 A1.2,1.2 0 0 1 16.4,17.3 V6.7 A1.2,1.2 0 0 1 17.6,5.5 Z</Geometry>
    </Window.Resources>

    <Grid x:Name="Root" Background="{x:Null}">
        <!-- Hover strip for the Tucked handle: nearly transparent (alpha 1) so the mouse registers; shown only in Tucked. -->
        <Border x:Name="HotStrip" Width="140" Height="8" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#01000000" Visibility="Collapsed" />

        <!-- The island. Its size, corners and position are animated from code; the clip follows its shape. -->
        <Grid x:Name="Body" HorizontalAlignment="Center" VerticalAlignment="Top"
              Width="236" Height="38" Background="{DynamicResource IslandBg}" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="BodyShift" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Tucked: a thin handle with a short accent line. -->
            <Grid x:Name="TuckLayer" Style="{StaticResource Layer}" Width="120" Height="6">
                <Rectangle Width="44" Height="2" RadiusX="1" RadiusY="1" Margin="0,0,0,1"
                           VerticalAlignment="Bottom" Fill="{DynamicResource IslandAccent}" Opacity="0.9" />
            </Grid>

            <!-- Timer pill: a running timer at rest, minutes only (decision D-20261125-crest-timers-rest-pill). -->
            <Grid x:Name="TimerPillLayer" Style="{StaticResource Layer}" Width="120" Height="30">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="13" Height="13" VerticalAlignment="Center">
                        <Ellipse Width="13" Height="13" Fill="{DynamicResource IslandAccent}" Opacity="0.24" />
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource IslandAccent}" />
                    </Grid>
                    <TextBlock x:Name="TimerPillText" Style="{StaticResource Title}" FontSize="13" Margin="8,0,0,0"
                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Text="0m" />
                </StackPanel>
            </Grid>

            <!-- Compact: art, title, equalizer. -->
            <Grid x:Name="CompactLayer" Style="{StaticResource Layer}" Width="236" Height="38">
                <Grid Margin="7,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CompactArt" Width="26" Height="26" CornerRadius="9" Margin="0,0,10,0"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="CompactTitle" Grid.Column="1" Style="{StaticResource Title}" FontSize="13"
                               VerticalAlignment="Center" Text="Nothing playing" />
                    <StackPanel x:Name="CompactEq" Grid.Column="2" Orientation="Horizontal" Height="14"
                                VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
            </Grid>

            <!-- Peek: a wider pill with the new track on two lines. -->
            <Grid x:Name="PeekLayer" Style="{StaticResource Layer}" Width="340" Height="54">
                <Grid Margin="9,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PeekArt" Width="38" Height="38" CornerRadius="12" Margin="0,0,12,0"
                            VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PeekTitle" Style="{StaticResource Title}" FontSize="13" />
                        <TextBlock x:Name="PeekSub" Style="{StaticResource Sub}" FontSize="11.5" />
                    </StackPanel>
                    <StackPanel x:Name="PeekEq" Grid.Column="2" Orientation="Horizontal" Height="14"
                                VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Grid>

            <!-- Expanded: art, track details, seek bar and controls. -->
            <Grid x:Name="ExpandedLayer" Style="{StaticResource Layer}" Width="392" Height="206">
                <Rectangle x:Name="Glow" IsHitTestVisible="False" />
                <StackPanel Margin="18,16,18,0">
                    <Grid Height="66">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ExpandedArt" Width="66" Height="66" CornerRadius="15" Margin="0,0,14,0"
                                VerticalAlignment="Center" BorderBrush="#14FFFFFF" BorderThickness="1" />
                        <StackPanel x:Name="ExpandedText" Grid.Column="1" VerticalAlignment="Center">
                            <!-- One line: the chip row below always shows (it holds the way to the Timers page). -->
                            <TextBlock x:Name="ExpandedTitle" Style="{StaticResource Title}" FontSize="16"
                                       TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                       MaxHeight="20" />
                            <TextBlock x:Name="ExpandedArtist" Style="{StaticResource Sub}" FontSize="13" Margin="0,1,0,0" />
                            <StackPanel x:Name="ChipRow" Orientation="Horizontal" Margin="0,6,0,0">
                                <!-- The app chip; with two or more apps it reads "App · 1 of 2" and switches app on click. -->
                                <Button x:Name="ExpandedAppChip" Style="{StaticResource ChipButton}" Margin="0" Click="OnSwitchApp">
                                    <DockPanel>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource IslandAccent}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ExpandedApp" Style="{StaticResource Sub}" FontSize="11" Margin="6,0,0,0" />
                                    </DockPanel>
                                </Button>
                                <!-- The stopwatch chip: the running time, and the way to the Timers page. -->
                                <Button x:Name="TimerChip" Style="{StaticResource ChipButton}" Margin="6,0,0,0" Padding="7,2,8,2"
                                        Click="OnTimerChip" Cursor="Hand" ToolTip="Timers" AutomationProperties.Name="Open timers">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                            <Path Width="24" Height="24" Stroke="{DynamicResource IslandMuted}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="{StaticResource StopwatchGeometry}" />
                                        </Viewbox>
                                        <TextBlock x:Name="TimerChipText" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0"
                                                   Foreground="{DynamicResource IslandAccent}" Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="ExpandedEq" Grid.Column="2" Orientation="Horizontal" Height="18"
                                    VerticalAlignment="Top" Margin="12,4,0,0" />
                    </Grid>

                    <Grid x:Name="SeekRow" Margin="0,14,0,0" Height="13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Elapsed" Style="{StaticResource Time}" Text="0:00" />
                        <Grid x:Name="SeekTrack" Grid.Column="1" Tag="control" Background="Transparent">
                            <Border x:Name="SeekRail" Height="5" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource IslandTrack}" />
                            <Border x:Name="SeekFill" Height="5" CornerRadius="3" Width="0" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                            <Ellipse x:Name="SeekKnob" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{DynamicResource IslandFg}" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="SeekKnobScale" ScaleX="0" ScaleY="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="Remaining" Grid.Column="2" Style="{StaticResource Time}" TextAlignment="Right"
                                   Text="-0:00" />
                    </Grid>

                    <StackPanel x:Name="Controls" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Click="OnShuffle" ToolTip="Shuffle">
                            <Path Style="{StaticResource StrokedIcon}"
                                  Data="M3,7 H6.5 C8.5,7 9.7,8 10.8,9.6 L13.2,14.4 C14.3,16 15.5,17 17.5,17 H21 M3,17 H6.5 C7.7,17 8.6,16.6 9.4,15.9 M13.6,8.1 C14.4,7.4 15.3,7 16.5,7 H21 M18,4 L21,7 L18,10 M18,14 L21,17 L18,20" />
                        </Button>
                        <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Click="OnPrevious" ToolTip="Previous">
                            <Path Style="{StaticResource FilledIcon}" Width="16" Height="16" Data="{StaticResource NextGeometry}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Click="OnPlayPause" ToolTip="Play or pause">
                            <Path x:Name="PlayIcon" Style="{StaticResource FilledIcon}" Width="16" Height="16" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource IconButton}" Click="OnNext" ToolTip="Next">
                            <Path Style="{StaticResource FilledIcon}" Width="16" Height="16" Data="{StaticResource NextGeometry}" />
                        </Button>
                        <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Click="OnRepeat" ToolTip="Repeat">
                            <Path Style="{StaticResource StrokedIcon}"
                                  Data="M4,11 V9 A3,3 0 0 1 7,6 H19 M16,3 L19,6 L16,9 M20,13 V15 A3,3 0 0 1 17,18 H5 M8,21 L5,18 L8,15" />
                        </Button>
                    </StackPanel>

                    <!-- Volume: whole-PC volume (decision D-20261124-crest-volume-row). -->
                    <Grid x:Name="VolumeRow" Margin="0,4,0,0" Height="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="24" Height="22" Margin="-4,0,0,0"
                                HorizontalAlignment="Left" Click="OnMute" ToolTip="Mute" Foreground="{DynamicResource IslandMuted}">
                            <Viewbox Width="15" Height="15">
                                <Grid Width="24" Height="24">
                                    <Path Data="M3.5,9 H7 L11.5,5 V19 L7,15 H3.5 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Path x:Name="SpeakerWaves" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Grid>
                            </Viewbox>
                        </Button>
                        <Grid x:Name="VolumeTrack" Grid.Column="1" Tag="control" Background="Transparent" Cursor="Hand">
                            <Border x:Name="VolumeRail" Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource IslandTrack}" />
                            <Border x:Name="VolumeFill" Height="4" CornerRadius="2" Width="0" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Background="{DynamicResource IslandFg}" />
                            <Ellipse x:Name="VolumeKnob" Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{DynamicResource IslandFg}" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="VolumeKnobScale" ScaleX="0" ScaleY="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="VolumePercent" Grid.Column="2" Style="{StaticResource Time}" TextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Timers page (design page version 7): the running or last-used timer on top, the others below. -->
            <Grid x:Name="TimersLayer" Style="{StaticResource Layer}" Width="392" Height="206">
                <Rectangle x:Name="TimersGlow" IsHitTestVisible="False" />
                <Grid Margin="18,16,18,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TimerTile" Style="{StaticResource TileButton}" Width="66" Height="66" Margin="0,0,14,0"
                                VerticalAlignment="Center" Click="OnTimerTile" AutomationProperties.Name="New timer">
                            <Path x:Name="TimerTileIcon" Width="26" Height="26" Stretch="Uniform" />
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TimerName" Style="{StaticResource Title}" FontSize="13" LineHeight="17"
                                       LineStackingStrategy="BlockLineHeight" Text="No timers yet" />
                            <TextBlock x:Name="TimerTime" FontSize="24" FontWeight="SemiBold" LineHeight="28"
                                       LineStackingStrategy="BlockLineHeight" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource IslandMuted}" Text="0:00" />
                            <!-- A Grid (not a StackPanel) gives the chip the column's width, so a long title trims with "…". -->
                            <Grid Margin="0,4,0,0">
                                <!-- The song chip: same row as the music page's stopwatch chip; leads back to Music. -->
                                <Button x:Name="SongChip" Style="{StaticResource ChipButton}" Margin="0" Padding="7,2,8,2" MaxWidth="200"
                                        Click="OnSongChip" Cursor="Hand" ToolTip="Back to music" AutomationProperties.Name="Back to music">
                                    <DockPanel>
                                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                            <Grid Width="24" Height="24">
                                                <Path Data="{StaticResource NoteGeometry}" Stroke="{DynamicResource IslandMuted}" StrokeThickness="2"
                                                      StrokeLineJoin="Round" />
                                                <Ellipse Width="5.2" Height="5.2" Margin="4,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                         Fill="{DynamicResource IslandMuted}" />
                                                <Ellipse Width="5.2" Height="5.2" Margin="14,13,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                         Fill="{DynamicResource IslandMuted}" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock x:Name="SongChipText" Style="{StaticResource Sub}" FontSize="11" Margin="5,0,0,0" Text="Music" />
                                    </DockPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <!-- Reset and delete for the top timer, where the equalizer sits on the music page. -->
                        <StackPanel x:Name="TimerActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                            <Button x:Name="TimerResetButton" Style="{StaticResource SmallIconButton}" Click="OnTopReset" ToolTip="Reset"
                                    AutomationProperties.Name="Reset">
                                <Viewbox Width="13" Height="13"><Path Style="{StaticResource SmallIcon}" Data="{StaticResource ResetGeometry}" /></Viewbox>
                            </Button>
                            <Button x:Name="TimerDeleteButton" Style="{StaticResource SmallIconButton}" Margin="2,0,0,0" Click="OnTopDelete"
                                    ToolTip="Delete" AutomationProperties.Name="Delete">
                                <Viewbox Width="13" Height="13"><Path Style="{StaticResource SmallIcon}" Data="{StaticResource CrossGeometry}" /></Viewbox>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="TimerConfirm" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="TimerConfirmText" FontSize="12" Foreground="{DynamicResource IslandFg}" VerticalAlignment="Center"
                                       Margin="0,0,4,0" Text="Reset?" />
                            <Button x:Name="TimerConfirmYes" Style="{StaticResource SmallIconButton}" Foreground="{DynamicResource IslandAccent}"
                                    Click="OnTopConfirmYes" AutomationProperties.Name="Yes">
                                <Viewbox Width="13" Height="13"><Path Style="{StaticResource SmallIcon}" Data="{StaticResource CheckGeometry}" /></Viewbox>
                            </Button>
                            <Button x:Name="TimerConfirmNo" Style="{StaticResource SmallIconButton}" Margin="2,0,0,0" Click="OnTopConfirmNo"
                                    AutomationProperties.Name="No">
                                <Viewbox Width="13" Height="13"><Path Style="{StaticResource SmallIcon}" Data="{StaticResource CrossGeometry}" /></Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- The other timers and the New timer row (plan task 6b). -->
                    <ScrollViewer x:Name="TimerListScroll" Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="TimerList" />
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Path x:Name="Hairline" Stroke="{DynamicResource IslandLine}" StrokeThickness="2" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
